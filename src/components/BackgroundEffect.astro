---
import { backgroundConfig } from "../config";

const { enable } = backgroundConfig;
---

{enable && (
	<div id="bg-effect" aria-hidden="true">
		<canvas id="bg-sky"></canvas>
		<canvas id="bg-dot-planet"></canvas>
		<canvas id="bg-sky-effects"></canvas>
	</div>
)}

<style>
	#bg-effect {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	#bg-sky,
	#bg-sky-effects {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	#bg-dot-planet {
		position: absolute;
		top: 47%;
		left: 76%;
		width: min(70rem, 96vw);
		aspect-ratio: 1.45;
		transform: translate(-50%, -50%);
	}

	@media (max-width: 767px) {
		#bg-dot-planet {
			top: 34%;
			left: 67%;
			width: min(138vw, 44rem);
		}
	}
</style>

<script>
	import { backgroundConfig } from "../config";
	import { createStarfield } from "../utils/starfield";
	import type { DotPlanet } from "../utils/dot-planet";

	function initBackground(root: HTMLElement) {
		const skyCanvas = root.querySelector<HTMLCanvasElement>("#bg-sky");
		const effectsCanvas = root.querySelector<HTMLCanvasElement>("#bg-sky-effects");
		const planetCanvas = root.querySelector<HTMLCanvasElement>("#bg-dot-planet");
		if (!skyCanvas || !effectsCanvas || !planetCanvas) return;

		const html = document.documentElement;
		const motion = matchMedia("(prefers-reduced-motion: reduce)");
		const sky = createStarfield(skyCanvas, effectsCanvas);
		let planet: DotPlanet | undefined;
		let hue = Number.NaN;
		let dark = false;
		let frameId = 0;
		let lastFrame: number | undefined;

		function refreshPalette() {
			const value = Number.parseFloat(getComputedStyle(html).getPropertyValue("--hue"));
			const nextHue = Number.isFinite(value) ? value : 250;
			const nextDark = html.classList.contains("dark");
			if (nextHue === hue && nextDark === dark) return;
			hue = nextHue;
			dark = nextDark;
			sky?.setPalette(hue, dark);
			planet?.setPalette(hue, dark);
			if (motion.matches) planet?.render(0);
		}

		function resize() {
			sky?.resize();
			planet?.resize();
			if (motion.matches) planet?.render(0);
		}

		function schedule() {
			if (!frameId && !document.hidden && !motion.matches) {
				frameId = requestAnimationFrame(frame);
			}
		}

		function frame(now: number) {
			frameId = 0;
			const dt = lastFrame === undefined ? 0 : Math.min(0.05, (now - lastFrame) / 1000);
			lastFrame = now;
			planet?.render(dt);
			sky?.render(dt);
			schedule();
		}

		function onPointerMove(event: PointerEvent) {
			if (event.pointerType === "mouse" && !motion.matches) sky?.setPointer(event.clientX, event.clientY);
		}

		function onPointerOut(event: PointerEvent) {
			if (event.pointerType === "mouse" && !event.relatedTarget) sky?.releasePointer();
		}

		function syncMotion() {
			if (document.hidden || motion.matches) {
				cancelAnimationFrame(frameId);
				frameId = 0;
				lastFrame = undefined;
				if (motion.matches) sky?.resetMotion();
				else sky?.releasePointer();
			} else {
				schedule();
			}
		}

		refreshPalette();
		resize();
		syncMotion();
		addEventListener("resize", resize, { passive: true });
		if (sky) {
			addEventListener("pointermove", onPointerMove, { passive: true });
			addEventListener("pointerout", onPointerOut, { passive: true });
			addEventListener("blur", sky.releasePointer);
		}
		motion.addEventListener("change", syncMotion);
		document.addEventListener("visibilitychange", syncMotion);
		new MutationObserver(refreshPalette).observe(html, {
			attributes: true,
			attributeFilter: ["class", "style"],
		});

		const gl = planetCanvas.getContext("webgl2", {
			antialias: false,
			powerPreference: "low-power",
		});
		if (gl) {
			void import("../utils/dot-planet").then(({ createDotPlanet }) => {
				planet = createDotPlanet(planetCanvas, gl, backgroundConfig.particleCount);
				planet.setPalette(hue, dark);
				planet.resize();
				planet.render(0);
				planetCanvas.addEventListener("webglcontextrestored", () => planet?.render(0));
			});
		}
	}

	const root = document.getElementById("bg-effect");
	if (root) initBackground(root);
</script>
